# =====================================================================
# GraphRAG - artefatos gerados (a estrutura de data/ é a padrão do GraphRAG)
# O índice congelado usado na avaliação deve ser publicado como Release.
# =====================================================================
data/output/
data/cache/
data/logs/
data/update_output/
# caminho criado por engano no Windows ("output\lancedb")
data/output*lancedb/

